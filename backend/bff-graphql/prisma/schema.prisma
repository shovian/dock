generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TicketCache {
  id String @id @default(uuid())
  key String @unique
  summary String
  description String?
  status String
  assignee String?
  reporter String?
  priority String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model PullRequestCache {
  id String @id @default(uuid())
  number Int
  title String
  description String?
  state String
  url String
  author String
  repository String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mergedAt DateTime?
  @@unique([repository, number])
  @@index([repository])
  @@index([state])
}

model DemoLink {
  id String @id @default(uuid())
  ticketKey String @unique
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketDependency {
  id           String   @id @default(uuid())
  ticketKey    String   @unique
  dependsOnKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dependsOnKey])
}

/// A work order number set in DOCK; it wins over the ticket's "#N" Jira label. Never written to Jira.
model TicketOrder {
  ticketKey String   @id
  position  Int?
  /// The owner works this ticket by hand: the cron never picks or resumes it.
  manual    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model QuickLink {
  id String @id @default(uuid())
  title String
  url String
  color String @default("#60a5fa")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([position])
}

model MonitorTarget {
  id             String    @id @default(uuid())
  name           String
  url            String
  expectedStatus Int       @default(200)
  timeoutMs      Int       @default(5000)
  lastStatus     String?
  lastStatusCode Int?
  lastLatencyMs  Int?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
}

model AppSettings {
  id String @id @default(uuid())
  key String @unique
  value String
  description String?
  updatedAt DateTime @updatedAt
}

model CacheEntry {
  key String @id
  value String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model MonitoredRepository {
  id String @id @default(uuid())
  owner String
  name String
  webhookSecret String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([owner, name])
}

model OrchestratorRun {
  key              String    @id
  title            String    @default("")
  stage            String
  waiting          String    @default("")
  payload          String
  activity         String    @default("IDLE")
  activityDetail   String?
  activityEndedAt  DateTime?
  lastEventAt      DateTime?
  ledgerUpdatedAt  DateTime  @default(now())
  transcriptAt     DateTime?
  dismissedAt      DateTime?
  machine          String    @default("laptop")
  ledgerRaw        String?
  handover         String?
  jiraStatus       String?
  jiraStage        String?
  /// Why the run is stalled although its last turn just ended, e.g. a lead that left subagents running. Cleared when a new turn starts.
  stalledDetail    String?
  stalledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stage])
}

/// A run removed because its ticket went back to To Do in Jira. A ledger made before resetAt does not bring it back.
model OrchestratorReset {
  key     String   @id
  machine String
  resetAt DateTime @default(now())
}

model OrchestratorEvent {
  id        String   @id @default(uuid())
  ticketKey String
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([ticketKey, createdAt])
}

model IngestToken {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  machine    String    @default("laptop")
  createdAt  DateTime  @default(now())
}

model OrchestratorToolEvent {
  id        Int      @id @default(autoincrement())
  ticketKey String
  kind      String
  agentId   String   @default("main")
  agentType String?
  name      String
  detail    String?
  at        DateTime

  @@index([ticketKey, id])
}

model ChatSession {
  id              String    @id
  source          String
  machine         String    @default("laptop")
  title           String    @default("")
  ticketKey       String?
  forkFrom        String?
  claudeSessionId String?
  status          String    @default("idle")
  statusDetail    String?
  messageCount    Int       @default(0)
  startedAt       DateTime
  lastMessageAt   DateTime
  lastDeltaAt     DateTime?
  options         String?
  /// "cron" for a session the orchestrator cron opened (it takes a cron slot), "manual" otherwise.
  origin          String    @default("manual")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source, lastMessageAt])
  @@index([ticketKey])
  @@index([machine, status])
}

model ChatMessage {
  id              Int       @id @default(autoincrement())
  sessionId       String
  role            String
  text            String
  state           String    @default("done")
  at              DateTime
  options         String?
  takenAt         DateTime?
  stopRequestedAt DateTime?

  @@index([sessionId, id])
  @@index([state])
}

model ChatActivity {
  id        Int       @id @default(autoincrement())
  sessionId String
  turnId    Int
  eventId   String
  parentId  String?
  kind      String
  agent     String    @default("main")
  name      String
  label     String    @default("")
  summary   String    @default("")
  detail    String?
  status    String    @default("running")
  seq       Int
  startedAt DateTime
  endedAt   DateTime?

  @@unique([sessionId, turnId, eventId])
  @@index([sessionId, seq])
  @@index([startedAt])
}

model ChatInteraction {
  id          Int       @id @default(autoincrement())
  sessionId   String
  turnId      Int
  requestId   String
  kind        String
  title       String    @default("")
  body        String
  state       String    @default("pending")
  answer      String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  answeredAt  DateTime?
  deliveredAt DateTime?

  @@unique([sessionId, turnId, requestId])
  @@index([sessionId, state])
  @@index([createdAt])
}

model ChatAttachment {
  id        String    @id
  sessionId String
  messageId Int?
  name      String
  mime      String
  size      Int
  sha256    String
  state     String    @default("uploaded")
  createdAt DateTime  @default(now())
  fetchedAt DateTime?

  @@index([sessionId, messageId])
  @@index([messageId])
  @@index([state, createdAt])
}

model ChatMachineInfo {
  machine     String   @id
  caps        String   @default("")
  catalog     String   @default("")
  catalogHash String   @default("")
  updatedAt   DateTime @updatedAt
}

model SprintSnapshot {
  sprintId   Int       @id
  name       String
  state      String
  startDate  DateTime
  endDate    DateTime
  result     String?
  computedAt DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

model SprintIssueEvents {
  sprintId  Int      @id
  issues    String
  fetchedAt DateTime
  labelPool String?
}

/// ElevenLabs keys the machines rotate over. Kept on the laptop DOCK only; the workspace DOCK reads and writes them there.
model ElevenLabsKey {
  name        String    @id
  key         String
  position    Int
  current     Boolean   @default(false)
  parkedUntil DateTime?
  createdAt   DateTime  @default(now())
}

/// A blackboard entry that waits on the owner (issue I-n with Resolver OWNER, or a SHOV decision D-n), sent by `sous dock-sync`.
model BoardItem {
  /// "<epic path>#I-12" or "<epic path>#D-3".
  id        String    @id
  /// The ingest token's machine that sent it; only that producer pulls its answers.
  machine   String
  payload   String
  updatedAt DateTime
  /// Set when the producer stopped sending the item (answered on the board, closed, confirmed).
  removedAt DateTime?

  @@index([machine])
}

/// The owner's answer to a board item. Kept with no expiry until `sous answer` writes it to the board and acknowledges it.
model BoardAnswer {
  id        Int       @id @default(autoincrement())
  itemId    String
  machine   String
  payload   String
  createdAt DateTime
  appliedAt DateTime?
  note      String?

  @@index([machine, appliedAt])
  @@index([itemId])
}
